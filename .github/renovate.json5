// Renovate replaces the npm-only Dependabot config it superseded: unlike
// Dependabot it can bump the wasmtts git-dependency tag in package.json
// (github:enstw/wasmtts#vX.Y.Z — semver tags, github-tags datasource picks
// them up natively) and, through the regex manager below, the ENSFont release
// pin in scripts/fetch-font.mjs. Inert until the Renovate GitHub App is
// installed on this repo — that installation is the one manual step.
// Every bump PR runs the full test gate; merging deploys.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended"],
  timezone: "Asia/Taipei",
  // one PR for the routine noise, like the Dependabot grouping it replaces;
  // majors and the two tracked upstreams still arrive individually
  packageRules: [
    {
      matchUpdateTypes: ["minor", "patch"],
      matchDatasources: ["npm"],
      groupName: "npm minor & patch",
    },
  ],
  customManagers: [
    // the ENSFont release pin: a plain const in the fetch script, not a
    // package.json entry, so no built-in manager sees it. The tag scheme
    // (v4.4.0_lxgw1.522_nerd3.5.0) is not semver — loose versioning sorts it.
    {
      customType: "regex",
      managerFilePatterns: ["/^scripts/fetch-font\\.mjs$/"],
      matchStrings: ['const FONT_RELEASE = "(?<currentValue>[^"]+)"'],
      depNameTemplate: "enstw/font",
      datasourceTemplate: "github-releases",
      versioningTemplate: "loose",
    },
  ],
}
