{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bookworm",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/books/*", "/admin"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bookworm",
      // Account-specific: scripts/deploy.sh rewrites this to whatever
      // `wrangler d1 create bookworm` yields on the account it deploys to.
      "database_id": "7d14d581-406b-40fd-bd3e-94078ebd50d8"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BOOKS",
      "bucket_name": "bookworm-books"
    }
  ],
  // The reader's own cron: announceSelf in src/worker.js rings 新版本已上線
  // within a minute of a new version serving (see DESIGN.md, "The reader
  // announces itself"); the pull-mode plan's owner-only messages and
  // silent-updater alarm will ride the same tick. One D1 read a minute.
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true }
}
